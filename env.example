# Set your own user ID, as desired
GADGETBRIDGE_USER=primary

# WebDAV (Nextcloud) source - where Gadgetbridge auto-exports the .db to
WEBDAV_URL=https://your-nextcloud-domain/remote.php/dav/
WEBDAV_PATH=files/your_nextcloud_user/GadgetBridge/
WEBDAV_USER=your_nextcloud_user
WEBDAV_PASS=your_nextcloud_app_password
EXPORT_FILENAME=Gadgetbridge.db

# How far back to query each run, in seconds. 86400 = 24h.
# If your cron runs more often than this, points will just be
# re-written (harmless - InfluxDB dedupes on identical timestamp+tags).
QUERY_DURATION=86400

# InfluxDB target
INFLUXDB_URL=http://your-influxdb-host:8086
INFLUXDB_TOKEN=your_influxdb_token
INFLUXDB_ORG=your_org
INFLUXDB_BUCKET=health
INFLUXDB_MEASUREMENT=colmi

# Hours (0-23, comma separated) to treat as "asleep" for stress
# field exclusion purposes
SLEEP_HOURS=0,1,2,3,4,5,6

# Set to Y only if you've confirmed your COLMI_* export uses
# millisecond timestamps rather than seconds (see comment in the
# script). Default assumption is seconds.
COLMI_TIMESTAMPS_ARE_MS=N

# Debug only - keep the temp sqlite copy instead of deleting it
REMOVE_TEMP_DB=Y
