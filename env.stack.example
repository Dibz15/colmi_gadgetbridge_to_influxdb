# Copy this file to .env (same directory as docker-compose.yml) and fill
# in real values. Compose reads .env automatically - anything left unset
# here falls back to the placeholder default in docker-compose.yml itself.
#
# .env should NOT be committed anywhere public - it holds real credentials.

### Parser image (once pushed to your own Docker Hub) ###
PARSER_IMAGE=dibz15/colmi2influx:latest

### Storage root - all persistent volumes live under here ###
APPDATA_ROOT=/DATA/AppData/biomarker-stack

### Shared InfluxDB settings (used by both the influxdb and parser services) ###
INFLUXDB_ORG=home
INFLUXDB_BUCKET=health
INFLUXDB_TOKEN=changeme_admin_token
INFLUXDB_MEASUREMENT=colmi
INFLUXDB_INIT_USERNAME=admin
INFLUXDB_INIT_PASSWORD=changeme_admin_password

### Grafana ###
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme_grafana_password

### ntfy ###
TZ=Europe/London

### Parser: Nextcloud WebDAV source ###
WEBDAV_URL=https://your-nextcloud-domain/remote.php/dav/
WEBDAV_PATH=files/your_nextcloud_user/GadgetBridge/
WEBDAV_USER=your_nextcloud_user
WEBDAV_PASS=your_nextcloud_app_password
EXPORT_FILENAME=Gadgetbridge

### Parser: behaviour ###
QUERY_DURATION=86400
SLEEP_HOURS=0,1,2,3,4,5,6
COLMI_TIMESTAMPS_ARE_MS=N
REMOVE_TEMP_DB=Y
SYNC_INTERVAL_SECONDS=1800

# Who this data belongs to. Tags every InfluxDB point. Defaults to
# "primary" and doesn't need to change for a single-user setup - it's a
# stop-over for if a second person/ring is ever added later (run a second
# parser instance pointed at their own WebDAV export with a different
# GADGETBRIDGE_USER value, both writing into the same bucket).
GADGETBRIDGE_USER=primary

### Wearable Events (calendar tagging + subjective sleep score) ###
EVENTS_MEASUREMENT=events
SLEEP_MEASUREMENT=subjective_sleep
CALENDAR_SYNC_INTERVAL_MINUTES=15
# Minimum sleep session length (seconds) to be eligible as "last night's
# sleep" when resolving a /sleep submission - excludes naps. 10800 = 3h.
MIN_SLEEP_SESSION_SECONDS=10800

# First-run login bootstrap. Only used if the users table is empty -
# creates this one account, then further household members are added
# from the app's Manage tab (no public signup page). Use the same
# username you use for GADGETBRIDGE_USER on your own ring parser
# instance, so your calendar/sleep data and HR/HRV data correlate later.
WEARABLE_EVENTS_ADMIN_USERNAME=primary
WEARABLE_EVENTS_ADMIN_PASSWORD=changeme_login_password

# Set to Y only if this is served behind TLS (e.g. a reverse proxy doing
# HTTPS) - adds the Secure flag to the session cookie. Leave N for plain
# HTTP over Tailscale (the common case here).
SESSION_COOKIE_SECURE=N
SESSION_MAX_AGE_DAYS=30
